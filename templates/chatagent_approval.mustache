{{!
    @template mod_minilesson/chatagent_approval

    Asks the teacher to approve something the assistant wants to do. Nothing is created or
    imported until they answer.

    Example context (json):
    {
        "callid": "fc_abc123",
        "summary": "aigen_import_items_json (cmid 507)",
        "argsjson": "{\"cmid\": 507}"
    }
}}
<div class="ml_chatagent_approval" data-callid="{{callid}}">
    <p class="ml_chatagent_approval_summary">{{#str}}chatagent_approvalprompt, mod_minilesson{{/str}}</p>
    <p class="ml_chatagent_approval_what">{{summary}}</p>
    <details class="ml_chatagent_approval_detail">
        <summary>{{#str}}chatagent_approvaldetails, mod_minilesson{{/str}}</summary>
        <pre>{{argsjson}}</pre>
    </details>
    <div class="ml_chatagent_approval_actions">
        <button type="button" class="btn btn-primary btn-sm" data-action="approve" data-callid="{{callid}}">
            {{#str}}chatagent_approve, mod_minilesson{{/str}}
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-action="decline" data-callid="{{callid}}">
            {{#str}}chatagent_decline, mod_minilesson{{/str}}
        </button>
    </div>
</div>
