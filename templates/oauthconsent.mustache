{{!
    @template mod_minilesson/oauthconsent

    OAuth consent screen shown at oauth_authorize.php. clientname/clienturi come from a
    DCR registration or a fetched CIMD document, so they are attacker-influenced -
    Mustache's default {{ }} escaping (not {{{ }}}) is relied on throughout.

    Context variables required for this template:
    * clientname string
    * clienturi string|null
    * formurl string
    * sesskey string
    * response_type, client_id, redirect_uri, code_challenge, code_challenge_method string
    * state string|null
    * resource string|null
    * scope string|null

    Example context (json):
    {
        "clientname": "Claude",
        "clienturi": "https://claude.ai",
        "formurl": "https://example.com/mod/minilesson/oauth_authorize.php",
        "sesskey": "abc123",
        "response_type": "code",
        "client_id": "mlc_xyz",
        "redirect_uri": "https://claude.ai/api/mcp/auth_callback",
        "code_challenge": "abc",
        "code_challenge_method": "S256",
        "state": "xyz",
        "resource": null,
        "scope": null
    }
}}
<div class="mod_minilesson_oauthconsent">
    <h3>{{#str}}oauthconsentheading, mod_minilesson{{/str}}</h3>
    <p>{{#str}}oauthconsentbody, mod_minilesson, {{clientname}}{{/str}}</p>
    {{#clienturi}}
        <p><a href="{{clienturi}}" target="_blank" rel="noopener noreferrer">{{#str}}oauthconsentclientlink, mod_minilesson{{/str}}</a></p>
    {{/clienturi}}
    <form method="post" action="{{formurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="response_type" value="{{response_type}}">
        <input type="hidden" name="client_id" value="{{client_id}}">
        <input type="hidden" name="redirect_uri" value="{{redirect_uri}}">
        <input type="hidden" name="code_challenge" value="{{code_challenge}}">
        <input type="hidden" name="code_challenge_method" value="{{code_challenge_method}}">
        {{#state}}<input type="hidden" name="state" value="{{state}}">{{/state}}
        {{#resource}}<input type="hidden" name="resource" value="{{resource}}">{{/resource}}
        {{#scope}}<input type="hidden" name="scope" value="{{scope}}">{{/scope}}
        <button type="submit" name="confirm" value="approve" class="btn btn-primary">{{#str}}oauthconsentapprove, mod_minilesson{{/str}}</button>
        <button type="submit" name="confirm" value="deny" class="btn btn-secondary">{{#str}}oauthconsentdeny, mod_minilesson{{/str}}</button>
    </form>
</div>
