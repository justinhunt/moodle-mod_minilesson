{{!
    @template mod_minilesson/chatagent_entry

    A link through to the chat agent, shown on the pages a teacher builds a lesson from. Says so
    when a conversation is waiting for them.

    Example context (json):
    {
        "url": "#",
        "pending": true
    }
}}
<div class="ml_chatagent_entry">
    <a href="{{url}}" class="btn {{#pending}}btn-primary{{/pending}}{{^pending}}btn-secondary{{/pending}}">
        {{#str}}chatagent_openassistant, mod_minilesson{{/str}}
        {{#pending}}
            <span class="badge badge-light ml_chatagent_entry_badge">
                {{#str}}chatagent_waitingonyou, mod_minilesson{{/str}}
            </span>
        {{/pending}}
    </a>
</div>
