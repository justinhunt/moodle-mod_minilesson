{{!
    @template mod_minilesson/aigencontextheader

    Header of the AI generate form: the template's name and the lesson's languages.

    Example context (json):
    {
        "templatename": "Vocabulary practice",
        "haslanguages": true,
        "targetlanguage": "English (US)",
        "nativelanguage": "Japanese",
        "easynotice": ""
    }
}}
<div class="minilesson_aigencontextheader mb-3">
    <h4 class="minilesson_aigencontextheader_title">{{templatename}}</h4>
    {{#haslanguages}}
        <dl class="row mb-0">
            <dt class="col-sm-4">{{#str}}ttslanguage, mod_minilesson{{/str}}</dt>
            <dd class="col-sm-8">{{targetlanguage}}</dd>
            <dt class="col-sm-4">{{#str}}nativelang, mod_minilesson{{/str}}</dt>
            <dd class="col-sm-8">
                {{nativelanguage}}
                {{#easynotice}}<div class="text-muted small">{{easynotice}}</div>{{/easynotice}}
            </dd>
        </dl>
    {{/haslanguages}}
</div>
