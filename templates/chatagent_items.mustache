{{!
    @template mod_minilesson/chatagent_items

    Read-only list of a lesson's items, shown beside the chat agent so a teacher can see what
    the assistant changed without leaving the conversation.

    Example context (json):
    {
        "hasitems": true,
        "count": 2,
        "additemurl": "#",
        "items": [
            {"index": 1, "name": "Ordering coffee", "typelabel": "Multichoice", "icon": null, "editurl": "#"}
        ]
    }
}}
<div class="ml_chatagent_itemlist">
    {{#hasitems}}
        <p class="ml_chatagent_itemcount">{{#str}}chatagent_itemcount, mod_minilesson, {{count}}{{/str}}</p>
        <ol class="ml_chatagent_items">
            {{#items}}
                <li class="ml_chatagent_item">
                    <a href="{{editurl}}" class="ml_chatagent_item_link">
                        {{#icon}}<img src="{{icon}}" alt="" class="ml_chatagent_item_icon">{{/icon}}
                        <span class="ml_chatagent_item_name">{{name}}</span>
                        <span class="ml_chatagent_item_type">{{typelabel}}</span>
                    </a>
                </li>
            {{/items}}
        </ol>
    {{/hasitems}}
    {{^hasitems}}
        <p class="ml_chatagent_empty">{{#str}}chatagent_noitemsyet, mod_minilesson{{/str}}</p>
        <a href="{{additemurl}}" class="btn btn-secondary btn-sm">{{#str}}chatagent_additems, mod_minilesson{{/str}}</a>
    {{/hasitems}}
</div>
