<h1 class="text-center">{{#str}}totalscore, mod_minilesson{{/str}} {{total}}%</h1>
<div class="quizrating">
    {{#yellowstars}}
        <span><img src="{{{ config.wwwroot }}}/mod/minilesson/pix/yellow_star.png"/></span>
    {{/yellowstars}}
    {{#graystars}}
        <span><img src="{{{ config.wwwroot }}}/mod/minilesson/pix/gray_star.png"/></span>
    {{/graystars}}
</div>
{{#showfullresults}}
<p>
    <a class="btn btn-primary itemscoresbutton" data-toggle="collapse" href="#itemscores" data-bs-toggle="collapse" data-bs-target="#itemscores" role="button" aria-expanded="false" aria-controls="itemscores" data-hide-text="{{#str}}hideitemscores, mod_minilesson{{/str}}" data-show-text="{{#str}}showitemscores, mod_minilesson{{/str}}" >
        {{#str}}showitemscores, mod_minilesson{{/str}}
    </a>
</p>
{{/showfullresults}}
{{#hasretryitems}}
<ul class="list-unstyled mod_minilesson_retrylist">
    {{#retryitems}}
    <li class="d-flex justify-content-between align-items-center">
        <span class="mod_minilesson_retrylist_title">{{index}}. {{title}}</span>
        <a class="btn btn-secondary btn-sm mod_minilesson_retrybutton" href="{{{retryurl}}}" aria-label="{{retryaria}}">{{retrylabel}}</a>
    </li>
    {{/retryitems}}
</ul>
{{/hasretryitems}}
<div class="collapse" id="itemscores">
{{#results}}
<div class="mod_minilesson_result_div">
    <div class="ml_result_card">
        <div class="ml_result_header">
            <span class="ml_result_index" aria-hidden="true">{{index}}</span>
            <h4 class="ml_result_heading">
                {{^ungraded}}
                <button type="button" class="ml_result_toggle" data-bs-toggle="collapse" data-toggle="collapse"
                        data-bs-target="#ml_result_{{index}}" data-target="#ml_result_{{index}}"
                        aria-expanded="true" aria-controls="ml_result_{{index}}">{{title}}</button>
                {{/ungraded}}
                {{#ungraded}}<span class="ml_result_toggle">{{title}}</span>{{/ungraded}}
            </h4>
            {{^ungraded}}
            <span class="ml_result_score">
                <span class="ml_result_stars">{{#yellowstars}}<img src="{{{ config.wwwroot }}}/mod/minilesson/pix/yellow_star.png" alt=""/>{{/yellowstars}}{{#graystars}}<img src="{{{ config.wwwroot }}}/mod/minilesson/pix/gray_star.png" alt=""/>{{/graystars}}</span>
                <span class="ml_result_grade">{{grade}}%</span>
            </span>
            {{/ungraded}}
            <span class="ml_result_actions">
                {{#hascommunitypage}}
                    <button type="button" class="btn btn-secondary btn-sm mod_minilesson_finishedcpagelink"
                            data-itemid="{{cpageitemid}}" data-target="ml_cpage_container_{{index}}">
                        {{#str}}cpage_title, mod_minilesson{{/str}}
                    </button>
                {{/hascommunitypage}}
                {{#retryurl}}
                    <a class="btn btn-secondary btn-sm mod_minilesson_retrybutton" href="{{{retryurl}}}" aria-label="{{retryaria}}">{{retrylabel}}</a>
                {{/retryurl}}
                {{^ungraded}}
                <button type="button" class="ml_result_chevron" data-bs-toggle="collapse" data-toggle="collapse"
                        data-bs-target="#ml_result_{{index}}" data-target="#ml_result_{{index}}"
                        aria-expanded="true" aria-controls="ml_result_{{index}}" tabindex="-1" aria-hidden="true">
                    <i class="fa fa-chevron-down"></i>
                </button>
                {{/ungraded}}
            </span>
        </div>
        {{^ungraded}}
        <div id="ml_result_{{index}}" class="collapse show in">
            <div class="ml_result_body">
                <ul class="minilesson_result">
                    <li><div class="mod_minilesson_question_text"><b>{{#str}}questiontext, mod_minilesson{{/str}}: </b><br/><div dir="{{contentdir}}" lang="{{contentlang}}">{{{questext}}}</div></div></li>
                    <li><div class="mod_minilesson_result_score"><b>{{#str}}score, mod_minilesson{{/str}}: </b><br/>{{correctitems}}/{{totalitems}}</div></li>
                    {{#hascorrectanswer}}
                        <li>
                            <div class="mod_minilesson_result_correctanswer"><b>{{#str}}correctanswer, mod_minilesson{{/str}}</b><br/>
                                {{#correctans}}<span class="mod_minilesson_finishedanswer" dir="{{contentdir}}" lang="{{contentlang}}">{{{sentence}}}</span>{{/correctans}}
                            </div>
                        </li>
                    {{/hascorrectanswer}}
                    {{#hasincorrectanswer}}
                        <li><div class="mod_minilesson_result_incorrectanswer"><b>{{#str}}incorrectanswer, mod_minilesson{{/str}} </b><br/>
                            {{#incorrectans}}<span class="mod_minilesson_finishedanswer" dir="{{contentdir}}" lang="{{contentlang}}">{{{sentence}}}</span>{{/incorrectans}}
                        </div>
                        </li>
                    {{/hasincorrectanswer}}
                    {{#hasanswerdetails}}
                    <li>
                        <div class="mod_minilesson_result_answerdetails"><b>{{#str}}answerdetails, mod_minilesson{{/str}}</b><br/>
                            <a class="mod_minilesson_finishedanswerdetailslink" data-target="ml_answerdetails_container_{{index}}" data-resultstemplate="{{resultstemplate}}" data-resultsdata="{{resultsdatajson}}" data-teacherreport="{{teacherreport}}" href="#">{{#str}}seeanswerdetails, mod_minilesson{{/str}}</a>
                        </div>
                    </li>
                    {{/hasanswerdetails}}
                </ul>
                <div id="ml_answerdetails_container_{{index}}" class="ml_qf_itemresults" style="display: none"></div>
            </div>
        </div>
        {{/ungraded}}
        {{#hascommunitypage}}
            <div id="ml_cpage_container_{{index}}" class="ml_qf_cpage" style="display: none"></div>
        {{/hascommunitypage}}
    </div>
</div>
{{/results}}
</div>
{{#backtocourse}}
<div class="minilesson_actionbutton">
<a class="btn btn-secondary backtocourse center" href="{{{courseurl}}}">{{#str}}backtotop, mod_minilesson{{/str}}</a>
</div>
{{/backtocourse}}
{{#reattempturl}}
<div class="minilesson_actionbutton">
<a class="btn btn-secondary btn_finished_attempt center" href="{{{reattempturl}}}" data-href="{{{reattempturl}}}" data-action="reattempt">
    {{#str}}reattempt, mod_minilesson{{/str}}</a>
</div>
{{/reattempturl}}
{{^element.frozen}}
{{#js}}
    require(['jquery', 'mod_minilesson/quizfinished'], function($, quizfinished) {
      quizfinished.init();
    });
{{/js}}
{{/element.frozen}}
