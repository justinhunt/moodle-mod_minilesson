<div class="audiochat-results-container">
    {{#aifeedback}}
    <div class="audiochat-results-feedback">
        <h4>{{#str}}feedback, mod_minilesson{{/str}}</h4>
        <p class="ml_ac_feedback_text" dir="{{#feedbackdir}}{{feedbackdir}}{{/feedbackdir}}{{^feedbackdir}}auto{{/feedbackdir}}">{{aifeedback}}</p>
    </div>
    {{/aifeedback}}
    {{#teacherreport}}
    <div class="audiochat-results-gradeexplanation">
        <h4>{{#str}}audiochat_gradeexplanation, mod_minilesson{{/str}}</h4>
        <p class="ml_ac_feedback_text">{{gradeexplanation}}</p>
    </div>
    {{/teacherreport}}
    <h4>{{#str}}audiochat_conversation, mod_minilesson{{/str}}</h4>
    {{#items}}
    {{#media}}
    <div class="audiochat-results-message assistant">
        <img class="ml_ac_picture" src="{{url}}" alt="{{filename}}">
    </div>
    {{/media}}
    {{^media}}
    <div class="audiochat-results-message {{usertype}}" dir="auto">
        {{{content}}}
    </div>
    {{/media}}
    {{/items}}
    {{#endedbyai}}
    <p class="audiochat-results-endedbyai" dir="auto">{{#str}}aichat_endedbyai, minilessonitem_audiochat{{/str}}</p>
    {{/endedbyai}}
</div>