{{!
    @template minilessonitem_speedreading/formexplainer

    The "How this item works" box at the top of the speed reading authoring form: the four screens
    the student sees, each matching one section of the form.

    Context variables required for this template: none.

    Example context (json):
    {}
}}
<div class="ml_sr_formexplainer">
    <div class="ml_sr_formexplainer_heading">{{#str}}formexplainer_heading, minilessonitem_speedreading{{/str}}</div>
    <p>{{#str}}formexplainer, minilessonitem_speedreading{{/str}}</p>
    <ol class="ml_sr_formsteps">
        <li><strong>{{#str}}screen1, minilessonitem_speedreading{{/str}}</strong><span>{{#str}}formexplainer_step1, minilessonitem_speedreading{{/str}}</span></li>
        <li><strong>{{#str}}screen2, minilessonitem_speedreading{{/str}}</strong><span>{{#str}}formexplainer_step2, minilessonitem_speedreading{{/str}}</span></li>
        <li><strong>{{#str}}screen3, minilessonitem_speedreading{{/str}}</strong><span>{{#str}}formexplainer_step3, minilessonitem_speedreading{{/str}}</span></li>
        <li><strong>{{#str}}screen4, minilessonitem_speedreading{{/str}}</strong><span>{{#str}}formexplainer_step4, minilessonitem_speedreading{{/str}}</span></li>
    </ol>
</div>
