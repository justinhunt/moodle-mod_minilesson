{{!
    @template minilessonitem_fiction/fiction_syntaxcheckresults

    The results of the Syntax Check button on the fiction item form.

    Example context (json):
    {
        "valid": true,
        "errors": [],
        "haswarnings": true,
        "warnings": ["Node \"End\" ends the story without <<stop>>. Add <<stop>> at its end."]
    }
}}
<div class="yarn-syntaxcheckresults">
    {{#valid}}
        <div class="yarn-syntaxcheckresults-valid">{{#str}} yarnsyntaxok , mod_minilesson {{/str}}</div>
    {{/valid}}
    {{^valid}}
        <div class="yarn-syntaxcheckresults-invalid">{{#str}} yarnsyntaxnotok , mod_minilesson {{/str}}</div>
        {{#errors}}
            <div class="yarn-syntaxcheckresults-error">{{.}}</div>
        {{/errors}}
    {{/valid}}
    {{#haswarnings}}
        <div class="yarn-syntaxcheckresults-warnings">{{#str}} yarnsyntaxwarnings , mod_minilesson {{/str}}</div>
        {{#warnings}}
            <div class="yarn-syntaxcheckresults-warning">{{.}}</div>
        {{/warnings}}
    {{/haswarnings}}
</div>