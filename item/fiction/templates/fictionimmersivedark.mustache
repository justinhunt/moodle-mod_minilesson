     data-sound-key-hard="{{immersivedark_sound_key_hard}}"
     data-sound-button="{{immersivedark_sound_button}}"
     data-font-regular="{{immersivedark_font_regular}}"
     data-font-italic="{{immersivedark_font_italic}}">

