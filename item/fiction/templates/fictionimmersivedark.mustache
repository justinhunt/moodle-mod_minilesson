{{!
    @template minilessonitem_fiction/fictionimmersivedark

    Immersive Dark layout for Fiction item.
    Card-based visual novel aesthetic with typewriter effect and WebAudio sounds.

    Example context (json):
    {
        "immersivedark_title": "The Count",
        "immersivedark_cover_url": "https://example.com/cover.jpg",
        "immersivedark_sound_key_soft": "https://example.com/key-soft.mp3",
        "immersivedark_sound_key_hard": "https://example.com/key-hard.mp3",
        "immersivedark_sound_button": "https://example.com/button.wav"
    }
}}
