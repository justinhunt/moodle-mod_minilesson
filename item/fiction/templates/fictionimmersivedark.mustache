        <div class="card__media"{{#immersivedark_cover_url}} style="background-image:url('{{immersivedark_cover_url}}')"{{/immersivedark_cover_url}}></div>

        <div class="card__panel">
            <div class="card__text-wrap">
                <p class="card__text"></p>
                <p class="card__translation"></p>
                <button class="card__translate" type="button" aria-label="{{#str}}fiction_translate, mod_minilesson{{/str}}">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path fill="currentColor" d="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
                    </svg>
                </button>
            </div>
            <div class="card__actions">
                <div class="yarnchoicescontainer">
                    <div class="minilesson_fiction_yarnoptions"></div>
                    <div class="option_container minilesson_fiction_continuebutton">
                        <div class="optiontext">{{#str}}continue{{/str}}</div>
                    </div>
                </div>
            </div>
        </div>

        <button class="card__start" type="button">
            <div class="card__start-image"{{#immersivedark_cover_url}} style="background-image:url('{{immersivedark_cover_url}}')"{{/immersivedark_cover_url}}></div>
            <div class="card__start-content">
                <h1 class="card__start-title">{{immersivedark_title}}</h1>
                <span class="card__start-cta">
                    <span class="card__start-icon">
                        <svg width="8" height="10" viewBox="0 0 8 10" fill="none" aria-hidden="true">
                            <path d="M0 0.500756C0 0.108038 0.431975 -0.131383 0.764999 0.0767575L7.3216 4.17463C7.63494 4.37047 7.63494 4.8268 7.3216 5.02263L0.764998 9.12051C0.431974 9.32865 0 9.08923 0 8.69651V0.500756Z" fill="currentColor"/>
                        </svg>
                    </span>
                    <span class="card__start-label">{{#str}}fiction_start, mod_minilesson{{/str}}</span>
                </span>
            </div>
        </button>
    </article>

    <div class="card__history-overlay" hidden>
        <button class="card__history-close" type="button" aria-label="{{#str}}fiction_history_close, mod_minilesson{{/str}}">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"/>
            </svg>
        </button>
        <div class="card__history-log"></div>
    </div>

    <div class="chat-wrapper"></div>
    <button id="scroll-bottom-btn"><i class="fa fa-chevron-down"></i></button>
</div>
