{{!
    @template minilessonitem_multichoicequiz/multichoicequiz

    Multichoice quiz item: a set of multichoice questions about a single shared
    resource (passage/media in the standard item prompt area), shown one at a time.

    Context variables required for this template:
    * uniqueid - unique id of the item on the page
    * questions - array of question objects (qindex, qnumber, questiontext, sentences)
    * questions.sentences - array of answer objects (index, indexplusone, sentence, prompt, resulttext)
    * totalquestions - number of questions
    * showallquestions - show all the questions at once, instead of one at a time
}}
{{> mod_minilesson/questionheader}}
{{> mod_minilesson/progresstimer}}
<div class="mcq_progressdots text-center" aria-hidden="true"></div>
<div class="mcq_questionsbox">
{{#questions}}
    <div class="mcq_question mcq_question_{{qindex}}" data-qindex="{{qindex}}" {{^showallquestions}}style="display: none;"{{/showallquestions}}>
        <div class="mcq_questiontext mod_minilesson_itemtext {{rtl}}">{{#showallquestions}}{{qnumber}}. {{/showallquestions}}{{questiontext}}</div>
        <div class="mcchoiceswrapper">
        {{#sentences}}
            <div class="row mcplayrow mcchoices">
                <div class="col-md-12">
                    <div class="minilesson_mc_response {{rtl}}" data-index="{{indexplusone}}" id="{{uniqueid}}_q{{qindex}}_option{{indexplusone}}" name="{{uniqueid}}_q{{qindex}}_options">
                        <span class="minilesson_sentence">{{prompt}}</span>
                        <span class="minilesson_mc_resultbox">
                        <i class="fa fa-check fa-lg minilesson_mc_right" style="display: none;"></i>
                        <i class="fa fa-times fa-lg minilesson_mc_wrong" style="display: none;"></i>
                        </span>
                    </div>
                </div>
            </div>
        {{/sentences}}
        </div>
    </div>
{{/questions}}
</div>
<div class="row mcplayrow">
    <div class="col-md-6" style="margin-left: auto;margin-right: auto">
        <div class="minilesson_mc_confirmchoice" style="display: none;" >
            <span class="minilesson_sentence">{{#str}}confirmchoice, mod_minilesson{{/str}}</span>
        </div>
    </div>
</div>
<div class="resultscontainer mcq_resultscontainer"></div>
{{> mod_minilesson/questionfooter}}
